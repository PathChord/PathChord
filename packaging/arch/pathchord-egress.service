[Unit]
Description=PathChord Egress proxy runtime
Documentation=man:pathchord(1)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pathchord
Group=pathchord
ExecStart=/usr/bin/pathchord egress --config-dir /etc/pathchord --egress-id egress --identity /var/lib/pathchord/egress.key.json --authorization-db /var/lib/pathchord/authorizations.db --control-socket /run/pathchord/egress.sock
Restart=on-failure
RestartSec=5s
StateDirectory=pathchord
RuntimeDirectory=pathchord
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/pathchord

[Install]
WantedBy=multi-user.target
