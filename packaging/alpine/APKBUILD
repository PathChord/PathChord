# Build explicitly with PATHCHORD_ROLE=ingress or PATHCHORD_ROLE=egress.
case "${PATHCHORD_ROLE:-}" in ingress) role=ingress; other=egress;; egress) role=egress; other=ingress;; *) echo 'set PATHCHORD_ROLE to ingress or egress' >&2; return 2;; esac
pkgname=pathchord-${role}d
pkgver=0.1.0
pkgrel=0
pkgdesc="PathChord $role runtime and local management client"
url="https://github.com/KagurazakaNyaa/PathChord"
arch="x86_64 aarch64 armv7 ppc64le s390x riscv64"
license="GPL-3.0-only"
depends="!pathchord-${other}d !pathchord"
if [ "$role" = ingress ]; then depends="$depends ca-certificates"; fi
makedepends="cargo"
pkgusers="pathchord"
pkggroups="pathchord"
install="pathchord.pre-install pathchord.pre-upgrade pathchord.post-install pathchord.post-upgrade pathchord.pre-deinstall"
source="PathChord-$pkgver.tar.gz::https://github.com/KagurazakaNyaa/PathChord/archive/refs/tags/v$pkgver.tar.gz"
sha256sums="SKIP"
build() {
    cd "$srcdir/PathChord-$pkgver"
    cargo build --release --locked --bin "$pkgname" --bin pathchordctl
}
package() {
    cd "$srcdir/PathChord-$pkgver"
    install -Dm0755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
    install -Dm0755 target/release/pathchordctl "$pkgdir/usr/bin/pathchordctl"
    install -Dm0755 packaging/common/setup-layout.sh "$pkgdir/usr/libexec/pathchord-setup-layout"
    install -Dm0644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm0644 packaging/common/pathchord.1 "$pkgdir/usr/share/man/man1/pathchord.1"
    install -Dm0644 packaging/common/pathchord.zh-CN.1 "$pkgdir/usr/share/man/zh_CN/man1/pathchord.1"
    gzip -n -9 "$pkgdir/usr/share/man/man1/pathchord.1"
    gzip -n -9 "$pkgdir/usr/share/man/zh_CN/man1/pathchord.1"
    if [ "$role" = ingress ]; then template=default-config.yaml; else template=default-egress-config.yaml; fi
    install -Dm0644 "packaging/common/$template" "$pkgdir/etc/pathchord/$role/$role.yaml"
    chmod 0750 "$pkgdir/etc/pathchord/$role"
    install -Dm0755 "packaging/alpine/$pkgname.initd" "$pkgdir/etc/init.d/$pkgname"
}
