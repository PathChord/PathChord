#!/sbin/openrc-run

name="pathchord"
description="PathChord Ingress proxy runtime"
command="/usr/bin/pathchord-ingressd"
command_args="--socket /run/pathchord/ingress.sock --config-dir /etc/pathchord/ingress --data-dir /var/lib/pathchord-ingress --credentials-dir /etc/pathchord/ingress/secrets"
command_user="pathchord:pathchord"
command_background="yes"
pidfile="/run/${RC_SVCNAME}.pid"
retry="TERM/30/KILL/5"

depend() {
	need net
	after firewall
}

start_pre() {
	checkpath --directory --owner pathchord:pathchord --mode 0750 /var/lib/pathchord-ingress
	checkpath --directory --owner pathchord:pathchord --mode 0750 /run/pathchord
	checkpath --directory --owner root:pathchord --mode 0750 /etc/pathchord/ingress/secrets
}
