#!/sbin/openrc-run

name="pathchord-ingressd"
description="PathChord Ingress proxy runtime"
command="/usr/bin/pathchord-ingressd"
command_args="--socket /run/pathchord/ingress.sock --config-dir /etc/pathchord/ingress --data-dir /var/lib/pathchord-ingress --credentials-dir /var/lib/pathchord-ingress/credentials"
command_user="pathchord:pathchord"
output_log="/var/lib/pathchord-ingress/service.log"
error_log="/var/lib/pathchord-ingress/service.log"
command_background="yes"
umask="0077"
pidfile="/run/${RC_SVCNAME}.pid"
retry="TERM/30/KILL/5"

depend() {
	need net
	after firewall
}

start_pre() {
	checkpath --directory --owner pathchord:pathchord --mode 0700 /var/lib/pathchord-ingress
	checkpath --directory --owner pathchord:pathchord --mode 0750 /run/pathchord
	checkpath --directory --owner pathchord:pathchord --mode 0700 /var/lib/pathchord-ingress/credentials
}
