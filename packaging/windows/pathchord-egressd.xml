<?xml version="1.0" encoding="UTF-8"?>
<!-- WinSW service definition. Keep this file beside the matching WinSW
     executable (pathchord-egressd-service.exe) before installing it. -->
<service>
  <id>PathChordEgressd</id>
  <name>PathChord Egressd</name>
  <description>PathChord authenticated Egress Path listener.</description>
  <startmode>Manual</startmode>
  <serviceaccount>
    <username>NT SERVICE\PathChordEgressd</username>
  </serviceaccount>
  <executable>%BASE%\pathchord-egressd.exe</executable>
  <arguments>--config-dir "%ProgramData%\PathChord\config\egress" --control-socket "\\.\pipe\pathchord-egress"</arguments>
  <workingdirectory>%ProgramData%\PathChord</workingdirectory>
  <logpath>%ProgramData%\PathChord\logs\egress</logpath>
  <log mode="roll" />
  <onfailure action="restart" delay="10 sec" />
  <stoptimeout>15 sec</stoptimeout>
</service>
