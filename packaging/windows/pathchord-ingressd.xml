<?xml version="1.0" encoding="UTF-8"?>
<!-- WinSW service definition. Keep this file beside the matching WinSW
     executable (pathchord-ingressd-service.exe) before installing it. -->
<service>
  <id>PathChordIngressd</id>
  <name>PathChord Ingressd</name>
  <description>PathChord local HTTP and SOCKS ingress listeners.</description>
  <startmode>Manual</startmode>
  <!-- The installer registers the wrapper first, then assigns the virtual
       service account through SCM once the service SID exists. -->
  <executable>%BASE%\pathchord-ingressd.exe</executable>
  <arguments>--socket "\\.\pipe\pathchord-ingress" --config-dir "%ProgramData%\PathChord\config\ingress" --data-dir "%ProgramData%\PathChord\data\ingress" --credentials-dir "%ProgramData%\PathChord\credentials\ingress"</arguments>
  <workingdirectory>%ProgramData%\PathChord</workingdirectory>
  <logpath>%ProgramData%\PathChord\logs\ingress</logpath>
  <log mode="roll" />
  <onfailure action="restart" delay="10 sec" />
  <stoptimeout>15 sec</stoptimeout>
</service>
