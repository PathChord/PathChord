[Unit]
Description=PathChord Ingress proxy runtime
Documentation=man:pathchord(1)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pathchord
Group=pathchord
ExecStart=/usr/bin/pathchord-ingressd --socket /run/pathchord/ingress.sock --config-dir /etc/pathchord/ingress --data-dir /var/lib/pathchord-ingress --credentials-dir /var/lib/pathchord-ingress/credentials
Restart=on-failure
RestartSec=5s
RuntimeDirectory=pathchord
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
StateDirectory=pathchord-ingress
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
DevicePolicy=closed
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/pathchord-ingress /run/pathchord

[Install]
WantedBy=multi-user.target
