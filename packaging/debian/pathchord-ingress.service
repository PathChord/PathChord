[Unit]
Description=PathChord Ingress proxy runtime
Documentation=man:pathchord(1)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pathchord
Group=pathchord
ExecStart=/usr/bin/pathchord --socket /run/pathchord/ingress.sock ingress --config-dir /etc/pathchord --data-dir /var/lib/pathchord --credentials-dir /etc/pathchord/secrets
Restart=on-failure
RestartSec=5s
RuntimeDirectory=pathchord
StateDirectory=pathchord
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/pathchord

[Install]
WantedBy=multi-user.target
