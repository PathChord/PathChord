[Unit]
Description=PathChord Ingress proxy runtime
Documentation=man:pathchord(1)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pathchord
Group=pathchord
ExecStart=/usr/bin/pathchord-ingressd --socket /run/pathchord/ingress.sock --config-dir /etc/pathchord/ingress --data-dir /var/lib/pathchord-ingress --credentials-dir /etc/pathchord/ingress/secrets
Restart=on-failure
RestartSec=5s
RuntimeDirectory=pathchord
StateDirectory=pathchord-ingress
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/pathchord-ingress

[Install]
WantedBy=multi-user.target
