#!/bin/sh

# PROVIDE: pathchord-egressd
# REQUIRE: NETWORKING
# KEYWORD: shutdown

. /etc/rc.subr

name="pathchord_egressd"
rcvar=pathchord_egressd_enable
load_rc_config "$name"

: "${pathchord_egressd_enable:=NO}"
: "${pathchord_egressd_user:=pathchord}"
: "${pathchord_egressd_config_dir:=/usr/local/etc/pathchord/egress}"
: "${pathchord_egressd_data_dir:=/var/db/pathchord-egress}"
: "${pathchord_egressd_control_socket:=/var/run/pathchord/egress.sock}"

# rc.subr applies the ${name}_user identity once; daemon must not drop it again.
command="/usr/sbin/daemon"
procname="/usr/local/bin/pathchord-egressd"
pidfile="/var/run/pathchord/${name}.pid"
command_args="-f -o ${pathchord_egressd_data_dir}/service.log -p ${pidfile} -- ${procname} --config-dir ${pathchord_egressd_config_dir} --control-socket ${pathchord_egressd_control_socket}"

start_precmd="pathchord_egressd_precmd"
pathchord_egressd_precmd()
{
	install -d -o "${pathchord_egressd_user}" -g "${pathchord_egressd_user}" -m 0700 "${pathchord_egressd_data_dir}"
	install -d -o "${pathchord_egressd_user}" -g "${pathchord_egressd_user}" -m 0750 /var/run/pathchord
    rm -f /var/run/pathchord/.restart-egress
}

run_rc_command "$1"
