#!/bin/sh

# PROVIDE: pathchord-egressd
# REQUIRE: NETWORKING pathchord-ingressd
# KEYWORD: shutdown

. /etc/rc.subr

name="pathchord_egressd"
rcvar=pathchord_egressd_enable
load_rc_config "$name"

: "${pathchord_egressd_enable:=NO}"
: "${pathchord_egressd_user:=pathchord}"
: "${pathchord_egressd_config_dir:=/usr/local/etc/pathchord/egress}"
: "${pathchord_egressd_data_dir:=/var/db/pathchord-egress}"
: "${pathchord_egressd_identity:=${pathchord_egressd_data_dir}/egress.key.json}"
: "${pathchord_egressd_id:=egress}"
: "${pathchord_egressd_bind:=0.0.0.0:7443}"
: "${pathchord_egressd_control_socket:=/var/run/pathchord/egress.sock}"

command="/usr/sbin/daemon"
procname="/usr/local/bin/pathchord-egressd"
pidfile="/var/run/${name}.pid"
command_args="-f -p ${pidfile} -u ${pathchord_egressd_user} -- ${procname} --config-dir ${pathchord_egressd_config_dir} --egress-id ${pathchord_egressd_id} --bind ${pathchord_egressd_bind} --identity ${pathchord_egressd_identity} --authorization-db ${pathchord_egressd_data_dir}/authorizations.sqlite --control-socket ${pathchord_egressd_control_socket}"

start_precmd="pathchord_egressd_precmd"
pathchord_egressd_precmd()
{
	install -d -o "${pathchord_egressd_user}" -g "${pathchord_egressd_user}" -m 0750 "${pathchord_egressd_data_dir}"
	install -d -o "${pathchord_egressd_user}" -g "${pathchord_egressd_user}" -m 0750 "$(dirname "${pathchord_egressd_control_socket}")"
}

run_rc_command "$1"
