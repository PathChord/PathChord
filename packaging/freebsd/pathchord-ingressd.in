#!/bin/sh

# PROVIDE: pathchord-ingressd
# REQUIRE: NETWORKING
# KEYWORD: shutdown

. /etc/rc.subr

name="pathchord_ingressd"
rcvar=pathchord_ingressd_enable
load_rc_config "$name"

: "${pathchord_ingressd_enable:=NO}"
: "${pathchord_ingressd_user:=pathchord}"
: "${pathchord_ingressd_config_dir:=/usr/local/etc/pathchord/ingress}"
: "${pathchord_ingressd_data_dir:=/var/db/pathchord-ingress}"
: "${pathchord_ingressd_credentials_dir:=${pathchord_ingressd_data_dir}/credentials}"

# rc.subr applies the ${name}_user identity once; daemon must not drop it again.
command="/usr/sbin/daemon"
procname="/usr/local/bin/pathchord-ingressd"
pidfile="/var/run/pathchord/${name}.pid"
command_args="-f -o ${pathchord_ingressd_data_dir}/service.log -p ${pidfile} -- ${procname} --socket /var/run/pathchord/ingress.sock --config-dir ${pathchord_ingressd_config_dir} --data-dir ${pathchord_ingressd_data_dir} --credentials-dir ${pathchord_ingressd_credentials_dir}"

start_precmd="pathchord_ingressd_precmd"
pathchord_ingressd_precmd()
{
	install -d -o "${pathchord_ingressd_user}" -g "${pathchord_ingressd_user}" -m 0700 "${pathchord_ingressd_data_dir}"
	install -d -o "${pathchord_ingressd_user}" -g "${pathchord_ingressd_user}" -m 0700 "${pathchord_ingressd_credentials_dir}"
	install -d -o "${pathchord_ingressd_user}" -g "${pathchord_ingressd_user}" -m 0750 /var/run/pathchord
    rm -f /var/run/pathchord/.restart-ingress
}

run_rc_command "$1"
